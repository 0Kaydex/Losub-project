PORT=3000

# A long, random string — used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# SendGrid
SENDGRID_API_KEY=
# Must be an email address verified as a sender in your SendGrid account
FROM_EMAIL=no-reply@yourdomain.com

# Where your Live Server / frontend is running
FRONTEND_URL=http://127.0.0.1:5500/html

# Where this backend itself is running (used to build email verification links)
BACKEND_URL=http://localhost:3000
