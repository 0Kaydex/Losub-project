# Copy this file to .env for local development, or set these as
# `fly secrets set KEY=value` for production (Fly.io) — the .env file
# itself is gitignored and NOT deployed via Docker.
#
# The server will crash on boot if RESEND_API_KEY or JWT_SECRET are missing.

# ---------- Core ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Wherever your frontend is served from (used to build email links)
FRONTEND_URL=https://losubapp.com/html
# Wherever this backend is deployed (used to build the email verification link)
BACKEND_URL=https://api.losubapp.com

# Optional — Fly.io persistent volume path. Leave unset for local dev
# (writes losub.db next to this file instead).
# DB_PATH=/data/losub.db

# ---------- Email (Resend, not SendGrid) ----------
# From resend.com/api-keys
RESEND_API_KEY=
# Must be a sender on a domain you've verified in Resend
FROM_EMAIL="Losub <noreply@losubapp.com>"

# ---------- Google Sign-In ----------
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=

# ---------- Paystack (wallet funding) ----------
# LIVE secret key for production — starts with sk_live_
# Get this from your Paystack dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=

# ---------- VTPass (airtime & data) ----------
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=
# https://vtpass.com/api for live, https://sandbox.vtpass.com/api for testing
VTPASS_BASE_URL=https://vtpass.com/api
