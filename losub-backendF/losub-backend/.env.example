PORT=3000

# A long, random string — used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Resend — https://resend.com
RESEND_API_KEY=
# Before you verify your own domain, this MUST use resend.dev as shown below.
# Once you verify a real domain in the Resend dashboard, change this to
# something like: Losub <no-reply@yourdomain.com>
FROM_EMAIL=Losub <onboarding@resend.dev>

# Where your Live Server / frontend is running
FRONTEND_URL=http://127.0.0.1:5500/html

# Where this backend itself is running (used to build email verification links)
BACKEND_URL=http://localhost:3000
